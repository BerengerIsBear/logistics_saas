# Copy to .env.tenant-test.local (the project's .gitignore already ignores .env*).
# Two TEST accounts must be ACTIVE ADMINS from DIFFERENT companies.
TEST_APP_URL=http://localhost:3000
TEST_A_EMAIL=admin-a@example.com
TEST_A_PASSWORD=replace-me
TEST_B_EMAIL=admin-b@example.com
TEST_B_PASSWORD=replace-me

# Optional but recommended. Create a customer in Company B with this exact
# unique name so aggregation/CSV tests can detect obvious tenant leaks.
TEST_B_MARKER=SECURITY-TEST-COMPANY-B-ONLY
